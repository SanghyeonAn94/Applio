FROM nvidia/cuda:12.8.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y \
    software-properties-common \
    && add-apt-repository ppa:deadsnakes/ppa \
    && apt-get update && apt-get install -y \
    python3.12 \
    python3.12-dev \
    python3.12-venv \
    git \
    wget \
    curl \
    ffmpeg \
    libsndfile1 \
    libportaudio2 \
    build-essential \
    unzip \
    && rm -rf /var/lib/apt/lists/*

RUN curl "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" -o "awscliv2.zip" \
    && unzip awscliv2.zip \
    && ./aws/install \
    && rm -rf awscliv2.zip aws

RUN curl -sS https://bootstrap.pypa.io/get-pip.py | python3.12

RUN update-alternatives --install /usr/bin/python python /usr/bin/python3.12 1 && \
    update-alternatives --install /usr/bin/python3 python3 /usr/bin/python3.12 1

WORKDIR /workspace

ENV NVIDIA_VISIBLE_DEVICES=all
ENV NVIDIA_DRIVER_CAPABILITIES=compute,utility

COPY requirements.txt /tmp/applio-requirements.txt

RUN pip install --no-cache-dir typing-extensions>=4.10.0

RUN pip install --no-cache-dir \
    torch==2.7.1 \
    torchvision==0.22.1 \
    torchaudio==2.7.1 \
    --index-url https://download.pytorch.org/whl/cu128

RUN pip install --no-cache-dir python-ffmpeg

RUN pip install --no-cache-dir -r /tmp/applio-requirements.txt

RUN mkdir -p /app/shared/cache_storage

COPY logs/mute /tmp/mute
COPY logs/mute_spin /tmp/mute_spin
COPY logs/mute_spin-v2 /tmp/mute_spin-v2

EXPOSE 6969

ENV API_HOST=0.0.0.0
ENV API_PORT=6969
ENV MODEL_DIR=/workspace/Applio
ENV S3_MODEL_URI=s3://shiftup-enterprise-ai-service/tts/model_registry/Applio/

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:6969/health || exit 1

RUN echo '#!/bin/bash\n\
set -e\n\
\n\
echo "=== Applio RVC Startup (EC2 Production) ==="\n\
echo "Model directory: $MODEL_DIR"\n\
echo "S3 source: $S3_MODEL_URI"\n\
echo ""\n\
\n\
# Check if model directory already exists and has content\n\
if [ -d "$MODEL_DIR" ] && [ "$(ls -A $MODEL_DIR 2>/dev/null)" ]; then\n\
  echo "Model files already exist in $MODEL_DIR"\n\
  echo "Skipping S3 download..."\n\
else\n\
  echo "Downloading model files from S3..."\n\
  echo "This may take several minutes on first startup..."\n\
  \n\
  # Create model directory\n\
  mkdir -p $MODEL_DIR\n\
  \n\
  # Download from S3 (using AWS CLI)\n\
  if ! aws s3 sync "$S3_MODEL_URI" "$MODEL_DIR" --delete --quiet; then\n\
    echo "ERROR: Failed to download model files from S3"\n\
    echo "Please check:"\n\
    echo "  1. AWS credentials (AWS_ACCESS_KEY_ID, AWS_SECRET_ACCESS_KEY, AWS_DEFAULT_REGION)"\n\
    echo "  2. S3 URI: $S3_MODEL_URI"\n\
    echo "  3. Network connectivity to S3"\n\
    exit 1\n\
  fi\n\
  \n\
  echo "Model files downloaded successfully"\n\
fi\n\
\n\
# Restore mute directories if they do not exist in mounted volume\n\
if [ ! -d "$MODEL_DIR/logs/mute" ]; then\n\
  echo ""\n\
  echo "Initializing mute directories..."\n\
  mkdir -p "$MODEL_DIR/logs"\n\
  if [ -d "/tmp/mute" ]; then\n\
    cp -r /tmp/mute "$MODEL_DIR/logs/"\n\
    cp -r /tmp/mute_spin "$MODEL_DIR/logs/"\n\
    cp -r /tmp/mute_spin-v2 "$MODEL_DIR/logs/"\n\
    echo "Mute directories initialized from image backup"\n\
  else\n\
    echo "Warning: Mute directories not found in image, creating empty ones"\n\
    mkdir -p "$MODEL_DIR/logs/mute" "$MODEL_DIR/logs/mute_spin" "$MODEL_DIR/logs/mute_spin-v2"\n\
  fi\n\
fi\n\
\n\
echo ""\n\
echo "Changing to model directory..."\n\
cd $MODEL_DIR\n\
\n\
echo "Current directory: $(pwd)"\n\
echo ""\n\
echo "Starting Applio RVC API on $API_HOST:$API_PORT..."\n\
exec python api.py -a "$API_HOST" -p "$API_PORT"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
