# ── Stage 1: pull base model assets from S3 (baked into the image so a cold
#    worker never has to fetch them at runtime; per-character checkpoints are
#    unrelated and still fetched lazily at inference/training time) ─────────
FROM amazon/aws-cli:2.15.0 AS asset-fetcher
ARG AWS_ACCESS_KEY_ID
ARG AWS_SECRET_ACCESS_KEY
ARG AWS_SESSION_TOKEN
ARG AWS_DEFAULT_REGION=ap-northeast-2
ARG APPLIO_MODEL_REGISTRY_S3=s3://shiftup-enterprise-ai-service/voice/model_registry/Applio
ENV AWS_ACCESS_KEY_ID=${AWS_ACCESS_KEY_ID} \
    AWS_SECRET_ACCESS_KEY=${AWS_SECRET_ACCESS_KEY} \
    AWS_SESSION_TOKEN=${AWS_SESSION_TOKEN} \
    AWS_DEFAULT_REGION=${AWS_DEFAULT_REGION}

RUN aws s3 sync "${APPLIO_MODEL_REGISTRY_S3}/rvc/models/" /assets/rvc_models/ && \
    echo "baked at build time" > /assets/rvc_models/.s3_synced

# ── Stage 2: runtime image ───────────────────────────────────────────────
# The fleet's combined image (voice-multi) runs all eight voice models inside a
# single container, so every repo has to agree on base image, interpreter and
# venv path. A repo that brings its own Ubuntu release or its own CPython makes
# that image ship two interpreters and two ~3GB copies of torch, for nothing.
# ubuntu24.04 (noble) already ships python3.12, which is why the deadsnakes PPA
# and the get-pip bootstrap below are gone.
FROM docker.io/nvidia/cuda:12.8.1-cudnn-runtime-ubuntu24.04

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PATH=/opt/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    APPLIO_BASE_DIR=/srv/applio \
    APPLIO_VOLUME_PATH=/runpod-volume/applio \
    APPLIO_WORK_ROOT=/tmp/work \
    APPLIO_MODEL_REGISTRY_S3=s3://shiftup-enterprise-ai-service/voice/model_registry/Applio \
    AWS_DEFAULT_REGION=ap-northeast-2

# python3.12-dev + build-essential stay because parts of the requirement set
# still build from source on this platform.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        python3.12 python3.12-dev python3.12-venv \
        git wget curl ffmpeg libsndfile1 libportaudio2 build-essential && \
    rm -rf /var/lib/apt/lists/*

# Everything below installs into /opt/venv (first on PATH), the shared location
# the combined image expects. Note that a venv does not fall back to apt's
# /usr/lib/python3/dist-packages, so every import has to come from pip here.
RUN python3.12 -m venv /opt/venv

# python3.12 no longer seeds setuptools into a fresh venv, so bootstrap the
# build trio before anything that needs a sdist/editable build.
RUN pip install --no-cache-dir --upgrade pip setuptools wheel

RUN pip install --no-cache-dir typing-extensions>=4.10.0

# torch 2.8.0 is the single version every voice image installs, so the fleet
# shares one torch/CUDA ABI (and 2.8 is the first stable series with sm_100).
# torchvision 0.23.0 is the release paired with torch 2.8.0 — the pair must move
# together or the compiled extensions break.
RUN pip install --no-cache-dir \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --index-url https://download.pytorch.org/whl/cu128

RUN pip install --no-cache-dir python-ffmpeg

# Code lives at /srv/<repo-key>, not /app: every repo in the fleet names its
# handler package `app`, so eight repos cannot all root their code at /app in
# the combined image. Building at the same absolute path the container runs from
# also keeps path-sensitive installs honest and removes PYTHONPATH patch-ups.
WORKDIR /srv/applio
# Compat symlink: the old code root stays valid for anything (scripts, docs,
# saved configs, external callers) that still says /app/Applio.
RUN mkdir -p /app && ln -s /srv/applio /app/Applio

# Applio's requirements pin torch/torchvision/torchaudio 2.7.1+cu128 outright,
# which would undo the install above (verified: the built image reported
# 2.7.1+cu128 despite the pin). Strip those three lines and re-assert the fleet
# version on the same command, so a genuine conflict fails the build loudly.
COPY requirements.txt /tmp/applio-requirements.txt
RUN grep -vE "^(torch|torchvision|torchaudio)==" /tmp/applio-requirements.txt \
        > /tmp/applio-req.runtime.txt && \
    pip install --no-cache-dir -r /tmp/applio-req.runtime.txt \
        torch==2.8.0 torchvision==0.23.0 torchaudio==2.8.0 \
        --extra-index-url https://download.pytorch.org/whl/cu128

RUN pip install --no-cache-dir boto3 httpx runpod

COPY logs/mute /tmp/mute
COPY logs/mute_spin /tmp/mute_spin
COPY logs/mute_spin-v2 /tmp/mute_spin-v2

COPY . /srv/applio

COPY --from=asset-fetcher /assets/rvc_models rvc/models

RUN echo '#!/bin/bash\n\
set -e\n\
cd "${APPLIO_BASE_DIR:-/srv/applio}"\n\
\n\
VOL="${APPLIO_VOLUME_PATH:-/runpod-volume/applio}"\n\
\n\
if [ -d "$VOL/rvc_models" ]; then\n\
    rm -rf rvc/models\n\
    ln -sfn "$VOL/rvc_models" rvc/models\n\
elif [ ! -f "rvc/models/.s3_synced" ]; then\n\
    echo "No volume, syncing rvc/models from S3..."\n\
    python -c "\n\
from app.s3_utils import ensure_local\n\
import os\n\
s3_base = os.environ.get(\"APPLIO_MODEL_REGISTRY_S3\", \"s3://shiftup-enterprise-ai-service/voice/model_registry/Applio\")\n\
ensure_local(\"rvc/models\", f\"{s3_base}/rvc/models/\")\n\
"\n\
fi\n\
\n\
mkdir -p logs\n\
if [ ! -d "logs/mute" ]; then cp -r /tmp/mute logs/mute; fi\n\
if [ ! -d "logs/mute_spin" ]; then cp -r /tmp/mute_spin logs/mute_spin; fi\n\
if [ ! -d "logs/mute_spin-v2" ]; then cp -r /tmp/mute_spin-v2 logs/mute_spin-v2; fi\n\
\n\
mkdir -p "$APPLIO_WORK_ROOT"\n\
\n\
exec "$@"\n\
' > /entrypoint.sh && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["python", "-u", "-m", "app.handler"]
